# Pin the base image by minor version. Slim cuts ~700MB of build tools we don't need.
FROM python:3.11.11-slim AS base

# Why these flags:
#   PYTHONDONTWRITEBYTECODE: don't write .pyc files (read-only fs friendly).
#   PYTHONUNBUFFERED: stream stdout/stderr immediately so docker logs are live.
#   PIP_NO_CACHE_DIR: smaller image, less to clean up.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/home/app/.cache/huggingface

# Non-root user. UID/GID 10001 keeps it well clear of host system users.
RUN groupadd --system --gid 10001 app \
 && useradd  --system --uid 10001 --gid 10001 --home-dir /home/app --create-home app \
 && mkdir -p /home/app/.cache/huggingface \
 && chown -R app:app /home/app/.cache

WORKDIR /app

# Install deps first so the layer is cached when only source changes.
# Torch is installed from the CPU-only index — saves ~1.5GB of CUDA libs we
# can't use in the container anyway. sentence-transformers picks up the
# already-installed torch instead of pulling the GPU build transitively.
#
# If requirements.txt has hash markers (one `--hash=sha256:...` per
# package, generated by `scripts/lock-deps.sh`), use --require-hashes so
# a tampered upstream package fails the build (audit C4-HIGH-6,
# 2026-05-12). Before the lockfile migration, the file has no hashes
# and the flag becomes a no-op via the `grep -q` gate below.
COPY requirements.txt /app/requirements.txt
RUN pip install --upgrade pip==24.3.1 \
 && pip install --index-url https://download.pytorch.org/whl/cpu torch==2.14.1 \
 && if grep -q -- '--hash=' /app/requirements.txt; then \
        pip install --require-hashes -r /app/requirements.txt; \
    else \
        echo "WARNING: requirements.txt has no hashes; supply-chain integrity not verified at install time. Run scripts/lock-deps.sh." >&2; \
        pip install -r /app/requirements.txt; \
    fi

# Copy source after deps. Ownership set so the non-root user can read.
COPY --chown=app:app . /app

USER app

EXPOSE 8000

# Single worker is correct here: sentence-transformers loads a ~130MB model
# in-process, and we want exactly one copy. Scale by adding more containers,
# not more workers.
#
# --forwarded-allow-ips '*' tells uvicorn to honour X-Forwarded-For from any
# upstream. The only path to this container is the docker-internal nginx
# (see docker-compose.yml — no `ports:` published on backend), so trusting
# the header here is safe AND necessary: without it, slowapi sees the nginx
# container IP for every request and the per-IP rate limiter degenerates
# into a single global bucket — one client can DoS login for everyone
# (audit finding H-1, 2026-05-10).
#
# The XFF arriving here is the value nginx forwards after the real_ip
# module has resolved Caddy's authoritative client IP (see frontend/
# nginx.conf and the loopback-only port binding in docker-compose.yml).
# That chain is what makes `--forwarded-allow-ips '*'` actually safe —
# don't publish the backend port, don't loosen the nginx config (audit
# C2-HIGH-1, 2026-05-12).
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "1", "--forwarded-allow-ips", "*"]
