# ---- Postgres ----
# Used by both the postgres container and the backend.
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change-me-to-a-strong-random-string
# Hostname is the docker-compose service name; do not change unless you rename it.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Backend ----
# 64+ random hex chars. Used to sign session ids / cookies.
SESSION_SECRET=change-me-openssl-rand-hex-32

# Locked-down CORS origin. For the default same-origin (nginx-proxied) deployment
# this can be left as the public URL of the frontend; the browser will not issue
# cross-origin requests, but the value still gates any direct backend access.
ALLOWED_ORIGIN=http://localhost:8080

# Set to "true" only behind HTTPS (Caddy/Let's Encrypt). Controls the Secure cookie flag.
COOKIE_SECURE=false

# AEAD key for at-rest encryption of TOTP secrets in the DB. Generate once:
#   python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Without this set, TOTP secrets are stored in plaintext (logs a loud
# WARNING on every setup). Existing plaintext rows are automatically
# rewrapped on the next successful verify. Rotation = set new key, all
# existing rows continue to decrypt with the OLD key — for a full
# rotate you'd need a rewrap CLI (not yet shipped).
TOTP_KMS_KEY=

# ---- LLM ----
# Which Chat-Completions backend to use. All three speak the same
# OpenAI-compatible contract; they differ only in URL + headers.
#   openrouter  -> hosted gateway (default). Requires OPENROUTER_API_KEY.
#   vllm        -> local OpenAI-compatible server (GPU-first, high throughput).
#   ollama      -> local OpenAI-compatible server (CPU-friendly, simplest).
# A local provider keeps every chat on your own infra: NO OpenRouter
# third-country transfer (Art. 44 ff.) — update datenschutz.html accordingly.
# Enable the local server via the compose `llm` profile (see docker-compose.yml):
#   docker compose --profile llm up -d
LLM_PROVIDER=openrouter
# Base URL of the local server (vllm/ollama only; ignored for openrouter).
# A trailing slash or an existing /v1 is normalised automatically.
#   vLLM:   LLM_BASE_URL=http://llm:8000
#   Ollama: LLM_BASE_URL=http://llm:11434
LLM_BASE_URL=

# Required for openrouter; OPTIONAL (leave empty) for vllm/ollama, which
# usually run without auth. When empty, no Authorization header is sent.
OPENROUTER_API_KEY=sk-or-v1-...
# For openrouter this is the model slug. For vllm/ollama it is the *served*
# model name (the HF repo vLLM was launched with, or the Ollama tag).
# Default: best price × quality × speed for German Q&A on internal docs.
# See README "Choosing & swapping the LLM" for the full table + tradeoffs.
# Tested non-thinking alternatives:
#   anthropic/claude-haiku-4-5         <-- default; ~1.5-3s TTFT, ~$1/$5 per 1M
#   anthropic/claude-sonnet-4-6        better answers, ~$3/$15 per 1M
#   google/gemini-2.5-flash            cheapest viable, ~1-2s TTFT
#   mistralai/mistral-medium-3.1       EU vendor, cleaner DSGVO story
#   openai/gpt-oss-120b                open weights, future self-host path
# AVOID: anything with `:free`, `:reasoning`, `:thinking`, `-r1`, `o1-*`,
# and specialized fine-tunes like gpt-oss-safeguard-20b (safety classifier,
# not a chat model).
OPENROUTER_MODEL=anthropic/claude-haiku-4-5
# Optional fallback model. Used only after OPENROUTER_MODEL exhausts its
# retry budget on 429/5xx from OpenRouter (e.g. during a workshop where
# the shared API key hits its rate limit). Pick a *different vendor* so
# you're not relying on the same upstream provider — e.g. a Mistral
# fallback for an Anthropic primary. Leave empty to disable.
OPENROUTER_FALLBACK_MODEL=
# On 429/502/503/504 we retry the same model this many *additional*
# times with exponential backoff (1s, 2s, 4s, ... capped at 30s,
# overridden by an upstream Retry-After header when sane). Then we
# switch to OPENROUTER_FALLBACK_MODEL if set.
OPENROUTER_MAX_RETRIES=2
OPENROUTER_RETRY_BASE_S=1.0
# Optional: LLM-attribution metadata only — sent to OpenRouter as the
# HTTP-Referer / X-Title headers so calls are identifiable in OpenRouter's
# dashboard. This is NOT the product brand: the user-facing app name, logo
# and colours are configured at runtime in the admin Branding tab (DB-backed,
# see migration 014). Local providers (vllm/ollama) ignore these.
OPENROUTER_REFERER=http://localhost:8080
OPENROUTER_TITLE=Internal Support RAG

# ---- Embeddings ----
# Local multilingual embedder (768-dim) — no API key needed. Swapping to a
# different dimension (e.g. bge-m3 at 1024) requires a new SQL migration of
# the chunks.embedding column. See migrations/003_multilingual_embeddings.sql
# for the precedent.
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# ---- External sources (URL connector) ----
# The URL connector fetches an operator-supplied allow-list of http(s) URLs,
# either via the admin endpoint POST /api/admin/sources/sync or the CLI
# (python ingest.py --source url --urls-file urls.txt --tags '["hr"]').
# External sources REQUIRE an explicit tags decision — they are never
# auto-public and tags are never derived from the URL. The fetch layer
# enforces an SSRF guard (rejects private/loopback/link-local/metadata
# ranges on every redirect hop), an http(s)-only scheme allow-list, and the
# byte/timeout caps below; if clamav is enabled, each payload is scanned
# fail-closed before parsing (same as the upload path).
#
# Connect + read timeout per fetch, in seconds.
SOURCE_FETCH_TIMEOUT_S=15.0
# Max bytes accepted per fetched URL, enforced WHILE streaming the body (a
# server Content-Length is never trusted). Defaults to the 20 MB upload cap.
SOURCE_MAX_BYTES=20971520
# User-Agent sent on every fetch (no version string, so it doesn't
# fingerprint the build).
URL_FETCH_USER_AGENT=WissensplattformBot/1.0

# ---- CRM / external-DB connector (Phase 4, OFF by default) ----
# Batch sync of ANONYMIZED CRM records INTO the document store. Runs in a
# SEPARATE one-off container (the 'crm' compose profile + backend/Dockerfile.sync)
# so Presidio's ~1.5 GB of NLP models never load in the always-on backend.
# There is NO live query on the chat path and NO write-back to the CRM.
# Enable with:
#   1. CRM_ENABLED=true, CRM_CONNECTOR=sql, set CRM_DSN + PII_PSEUDONYM_KEY
#   2. Author a connector spec JSON (query/columns/field_actions/group_map),
#      mount it (./crm), point CRM_SPEC_FILE at it.
#   3. docker compose --profile crm run --rm crm-sync --spec /app/crm/spec.json
CRM_ENABLED=false
# Connector kind. Today only 'sql' (read-only external SQL replica).
CRM_CONNECTOR=
# !!! CRM_DSN MUST be a READ-ONLY libpq DSN — a DB role with ONLY SELECT
# grants. The SELECT-only query check in the connector is defense-in-depth,
# NOT the primary control. Never point this at a writable role. !!!
#   e.g. host=crm-replica port=5432 dbname=crm user=crm_ro password=...
CRM_DSN=
# !!! PII_PSEUDONYM_KEY: HMAC key for deterministic pseudonymization of
# structured fields. ROTATING THIS KEY CHANGES EVERY PSEUDONYM AND REQUIRES A
# FULL RE-SYNC (old documents would otherwise read inconsistently). Generate
# once, store securely, treat like SESSION_SECRET:  openssl rand -hex 32  !!!
PII_PSEUDONYM_KEY=
# Row cap per sync run (LIMIT appended to the operator query).
CRM_MAX_RECORDS_PER_RUN=5000
# Per-record character cap on the SCRUBBED text fed to the embedder.
CRM_MAX_RECORD_CHARS=20000
# Languages the Presidio NER backstop runs (comma-separated). de+en matches
# the pinned spaCy models in backend/requirements-sync.txt.
PRESIDIO_LANGUAGES=de,en
# Optional periodic re-sync interval (seconds) for a long-running sync
# container. 0 = one-shot (the container exits after one pass).
CRM_SYNC_INTERVAL_S=0
# Path (inside the sync container) to the operator-authored connector spec
# JSON. Can also be passed as --spec. Mount it via the ./crm volume.
CRM_SPEC_FILE=/app/crm/spec.json

# ---- ClamAV (optional malware scan auf Admin-Upload) ----
# Aktivieren mit:
#   1. CLAMAV_ENABLED=true setzen
#   2. docker compose --profile security up -d
# Kostet ~1 GB RAM für die Signatur-Datenbank. Auf Plänen mit ≤4 GB RAM aus
# lassen. Wenn aktiviert UND clamd nicht erreichbar: Uploads schlagen fehl
# (fail-closed) — bewusste Sicherheitsentscheidung.
CLAMAV_ENABLED=false

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Tracing (OpenTelemetry, off by default) ----
# Set OTEL_EXPORTER_OTLP_ENDPOINT to a collector base URL (NO trailing /v1/traces)
# to ship spans via OTLP/HTTP. Set OTEL_CONSOLE_EXPORTER=true to additionally
# dump spans to backend stdout — useful for local debugging, noisy in prod.
# Both unset -> spans are created but discarded (zero exporter overhead).
# Standard OTel envs (OTEL_SERVICE_NAME, OTEL_RESOURCE_ATTRIBUTES, etc.) also apply.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_CONSOLE_EXPORTER=false
