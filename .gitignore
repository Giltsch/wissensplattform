# Secrets
.env
.env.local
*.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Models cache (sentence-transformers downloads)
.cache/
hf-cache/

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp

# Docker volumes mounted locally (if any)
pgdata/

# Ingested docs may be sensitive — keep .gitkeep but not the contents
docs/*
!docs/.gitkeep

# Database backups produced by ./backup.sh — never commit these
backups/

# Operator-authored CRM connector spec (real column names / mapping) — keep
# only the example. The DSN + pseudonym key live in .env, never here.
crm/*
!crm/spec.example.json

# Internal notes, not part of the public repo
SECURITY-AUDIT-*.md
BLUEPRINT_VERGLEICH.md
.claude/

# Generated by build-*-docs.js
*.docx
